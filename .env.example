# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore, so it is never pushed to GitHub.
# These are read ONLY by the Python API (api/index.py), never by React.

# Supabase -> Project Settings -> API (or "Data API") -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API Keys -> service_role (secret) key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string, used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
